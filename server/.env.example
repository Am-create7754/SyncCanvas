# Port the Socket.IO/Express server listens on.
PORT=4000

# Comma-separated list of allowed client origins for CORS (Socket.IO + Express).
# In production, set this to your deployed frontend's real origin(s) — never "*".
CLIENT_URL=http://localhost:5173

# Set to "true" to enable verbose [debug] server logs. Leave unset/false in production.
DEBUG_SYNCCANVAS=false
